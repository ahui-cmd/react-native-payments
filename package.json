{
  "name": "@react-native-ohos/react-native-payments",
  "version": "0.8.4-beta.1",
  "description": "Welcome to the best and most comprehensive library for integrating payments like Apple Pay and Google Pay into your React Native app.",
  "scripts": {
    "pack": "npm pack",
    "run:packager": "cd examples/native && yarn run:packager",
    "run:ios": "cd examples/native && yarn run:ios",
    "run:web": "cd examples/web && yarn run:web",
    "run:demo": "cd examples/native && yarn run:demo",
    "lint": "eslint ./lib/js",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --config jest/jest.config.js",
    "test:coverage": "jest --config jest/jest.config.js --coverage"
  },
  "homepage": "https://github.com/react-native-oh-library/react-native-payments",
  "repository": {
    "type": "git",
    "url": "git@github.com:react-native-oh-library/react-native-payments.git"
  },
  "bugs": {
    "url": "https://github.com/react-native-oh-library/react-native-payments"
  },
  "keywords": [
    "react",
    "react-native",
    "apple-pay",
    "stripe",
    "braintree",
    "payments",
    "payment-request",
    "sca",
    "strong customer authentication",
    "2 factor",
    "2fa",
    "android",
    "ios",
    "payment intents",
    "cross platform",
    "harmony",
    "ohos",
    "openharmony",
    "rnoh"
  ],
  "author": "Naoufal Kadhom & Freeman Industries",
  "license": "MIT",
  "dependencies": {
    "es6-error": "^4.0.2",
    "uuid": "^3.1.0",
    "validator": "^9.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-flow": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^29.7.0",
    "babel-preset-react-native": "2.0.0",
    "eslint": "^5.16.0",
    "eslint-config-airbnb-base": "^13.1.0",
    "eslint-plugin-flowtype": "^4.7.0",
    "eslint-plugin-import": "^2.17.3",
    "husky": "^0.14.1",
    "jest": "^29.7.0",
    "react-native": "^0.63.3",
    "react-test-renderer": "16.0.0-alpha.12"
  },
  "peerDependencies": {
    "react": ">=15",
    "react-native": ">=0.60"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/example/",
      "/oh_modules/"
    ],
    "roots": [
      "<rootDir>/js"
    ]
  },
  "main": "js/index.js",
  "harmony": {
    "alias": "react-native-payments",
    "autolinking": {
      "cppPackageClassName": "RNPaymentsPackage",
      "cmakeLibraryTargetName": "rnoh_payments",
      "ohPackageName": "@react-native-ohos/react-native-payments",
      "etsPackageClassName": "RNPaymentsPackage"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "js",
    "react-native-payments.podspec",
    "README_en.md",
    "README.OpenSource",
    "CHANGELOG.md",
    "docs",
    "harmony/rn_payments/src",
    "harmony/rn_payments/Index.ets",
    "harmony/rn_payments/oh-package.json5",
    "harmony/rn_payments/hvigorfile.ts",
    "harmony/rn_payments/build-profile.json5"
  ]
}
